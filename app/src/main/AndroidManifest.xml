<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- §9 Internet behaviour: detect connectivity and sync without manual intervention. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- §22 Auto-start after boot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      §10 GPS every 10 minutes during working hours, §11 attendance check-in/out.
      ACCESS_BACKGROUND_LOCATION (API 29+) must be requested in its own separate step, never in the
      same dialog as foreground location. See docs/research/ for the grant-flow rules.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- §11 optional attendance photo. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- §24 FCM push notifications (API 33+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Deliberately NOT declared, per docs/adr/0002-telephony-architecture.md:
        CALL_PHONE, READ_CALL_LOG, WRITE_CALL_LOG, RECORD_AUDIO, READ_PHONE_STATE.
      Calls are bridged server-side by the telephony provider. The device never dials a customer
      number, never records audio, and never reads the system call log. This keeps the app out of
      Google Play's sensitive-permission review entirely.
    -->

    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".AsktrixApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Asktrix.Starting"
        tools:targetApi="33"
        xmlns:tools="http://schemas.android.com/tools">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Asktrix.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- §22: resume background sync after a reboot or an app update. -->
        <receiver
            android:name=".boot.BootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- §24: FCM. Payloads carry identifiers only, never customer data. -->
        <service
            android:name=".push.AsktrixMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- WorkManager is initialised on demand through Hilt, not by the default initializer. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
